# Application runtime connection. Copy values from the Supabase Connect dialog.
ConnectionStrings__ResearchDb=Host=YOUR_HOST;Port=5432;Database=postgres;Username=YOUR_USERNAME;Password=YOUR_PASSWORD;SSL Mode=Require

# Keep false in production and run migrations as a separate deployment step.
Database__ApplyMigrationsOnStartup=false

# Used later for private source code storage. Never expose the service role key to a browser.
Supabase__Url=https://YOUR_PROJECT_REF.supabase.co
Supabase__ServiceRoleKey=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
Supabase__StorageBucket=source-code
