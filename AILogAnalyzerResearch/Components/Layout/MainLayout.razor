@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row">
            <div>
                <span class="top-label">Research workspace</span>
                <strong>AI Coding Log Analyzer</strong>
            </div>
            <div class="environment-pill"><span></span> Local research dataset</div>
        </div>

        <article class="content">
